    {
      "id": 10,
      "type": "piechart",
      "title": "Saga outcomes (terminal)",
      "datasource": {
        "type": "postgres",
        "uid": "finflow-postgres"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "finflow-postgres"
          },
          "rawSql": "SELECT current_state AS outcome, COUNT(*)::float8 AS sagas FROM saga.saga_instances WHERE current_state IN ('COMPLETED', 'COMPENSATED', 'COMPENSATION_FAILED') GROUP BY current_state ORDER BY sagas DESC;",
          "rawQuery": true,
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
