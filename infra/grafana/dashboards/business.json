{
  "uid": "finflow-business",
  "title": "FinFlow \u2014 Business",
  "description": "Spend, sagas, and commitment health. Spend comes from Postgres (exact, permanent); saga/commitment signals come from Prometheus (operational, sampled).",
  "tags": [
    "finflow",
    "business",
    "finops"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Spend \u2014 from Postgres (cost_ledger is the system of record)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total spend (USD)",
      "datasource": {
        "type": "postgres",
        "uid": "finflow-postgres"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "finflow-postgres"
          },
          "rawSql": "SELECT COALESCE(SUM(cost_usd), 0)::float8 AS \"Total spend\" FROM cost_ledger;",
          "rawQuery": true,
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [],
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "description": "All-time normalized spend across every vendor. Read straight from the cost_ledger table \u2014 the system of record \u2014 not from Prometheus, because financial data needs to be exact and permanent."
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "Spend by vendor",
      "datasource": {
        "type": "postgres",
        "uid": "finflow-postgres"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "finflow-postgres"
          },
          "rawSql": "SELECT vendor, SUM(cost_usd)::float8 AS spend FROM cost_ledger GROUP BY vendor ORDER BY spend DESC;",
          "rawQuery": true,
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "currencyUSD",
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "The headline FinOps number: where the money goes. cost_ledger has an index on vendor, so this is a cheap grouped aggregate."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Spend over time by vendor",
      "datasource": {
        "type": "postgres",
        "uid": "finflow-postgres"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "finflow-postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(normalized_at, $__interval), vendor AS metric, SUM(cost_usd)::float8 AS spend FROM cost_ledger WHERE $__timeFilter(normalized_at) GROUP BY 1, vendor ORDER BY 1;",
          "rawQuery": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Spend bucketed by normalized_at (when cost-normalizer wrote the row). Honest caveat: this is INGESTION time, not the vendor's usage time \u2014 usage_start is a vendor-format string, not a timestamp, so it can't be time-grouped without a cast. See the manifest."
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Spend by team (top 10)",
      "datasource": {
        "type": "postgres",
        "uid": "finflow-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "finflow-postgres"
          },
          "rawSql": "SELECT team, SUM(cost_usd)::float8 AS spend FROM cost_ledger GROUP BY team ORDER BY spend DESC LIMIT 10;",
          "rawQuery": true,
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "mappings": [],
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "description": "Showback by team \u2014 the enriched 'team' column comes from the accounts lookup in cost-normalizer. 'unassigned' means the account_id had no mapping."
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top services by spend",
      "datasource": {
        "type": "postgres",
        "uid": "finflow-postgres"
