        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "finflow-postgres"
          },
          "rawSql": "SELECT vendor, service, SUM(cost_usd)::float8 AS spend, COUNT(*) AS line_items FROM cost_ledger GROUP BY vendor, service ORDER BY spend DESC LIMIT 10;",
          "rawQuery": true,
          "format": "table",
          "editorMode": "code"
