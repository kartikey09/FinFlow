{
  "uid": "finflow-reliability",
  "title": "FinFlow \u2014 Reliability",
  "description": "Operational health: consumer lag, outbox backlog, circuit-breaker state, chaos fault rate, and saga latency. All Prometheus (+ kafka-exporter for broker-side lag).",
  "tags": [
    "finflow",
    "reliability",
    "sre"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service health",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Services UP",
      "datasource": {
        "type": "prometheus",
        "uid": "finflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "finflow-prometheus"
          },
          "expr": "sum(up{job=\"finflow-services\"})",
          "legendFormat": "up",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "fixedColor": "green"
          },
          "mappings": [],
          "unit": null,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "green",
                "value": 9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "description": "Out of 9 scrape targets. Anything below 9 means a service is down or not started. This is the first panel to check when a dashboard looks empty."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Service up / down",
      "datasource": {
        "type": "prometheus",
        "uid": "finflow-prometheus"
