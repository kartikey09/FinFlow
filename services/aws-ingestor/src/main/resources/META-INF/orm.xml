<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_0.xsd"
                 version="3.0">

    <!--
      Pin the SHARED outbox table to the `public` schema for this service.

      The outbox-starter's OutboxEvent is annotated @Table(name="outbox_event")
      with NO schema, so by default it follows this service's
      hibernate.default_schema (= "ingestion"). But Debezium tails
      `public.outbox_event`. This XML re-homes ONLY that one entity to `public`,
      leaving the ingestor's own entities (poll_cursor, cost_line_items_raw)
      under "ingestion".

      Done here, in the consuming service, rather than by editing the locked
      outbox-starter: where the shared outbox physically lives is each adopter's
      deployment choice, not the library's. XML overrides annotations in JPA, so
      this needs no change to OutboxEvent.java.
    -->
    <entity class="io.finflow.outbox.OutboxEvent">
        <table name="outbox_event" schema="public"/>
    </entity>

</entity-mappings>
